[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/difficulty_report.gd" id="1_script"]

[sub_resource type="Theme" id="Theme_report"]
default_font_size = 14
Label/colors/font_color = Color(0.95, 0.88, 0.7, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.06, 0.04, 0.09, 0.82)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.5, 0.36, 0.18, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="DifficultyReport" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_report")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.09, 0.07, 0.12, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.86, 0.5, 1)
theme_override_font_sizes/font_size = 26
text = "Modo prueba · Curva de dificultad"

[node name="SummaryLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Body" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="TablePanel" type="PanelContainer" parent="Margin/VBox/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="TableBox" type="VBoxContainer" parent="Margin/VBox/Body/TablePanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TableHeader" type="HBoxContainer" parent="Margin/VBox/Body/TablePanel/TableBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="TableScroll" type="ScrollContainer" parent="Margin/VBox/Body/TablePanel/TableBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Margin/VBox/Body/TablePanel/TableBox/TableScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="CapacityPanel" type="PanelContainer" parent="Margin/VBox/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="CapacityBox" type="VBoxContainer" parent="Margin/VBox/Body/CapacityPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="CapacityTitle" type="Label" parent="Margin/VBox/Body/CapacityPanel/CapacityBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.86, 0.5, 1)
theme_override_font_sizes/font_size = 18
text = "Capacidad del mapa"

[node name="CapacityHint" type="Label" parent="Margin/VBox/Body/CapacityPanel/CapacityBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.72, 0.85, 0.85)
theme_override_font_sizes/font_size = 12
text = "Genera mapas de muestra y compara enemigos y trampas colocados/pedidos. Libres: celdas aptas que respetan la separación con todo lo colocado. +Enem. y +Tramp.: cuántos más cabrían respetando la separación mínima. (E) = diseño de emergencia."
autowrap_mode = 3

[node name="CapacityButton" type="Button" parent="Margin/VBox/Body/CapacityPanel/CapacityBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Analizar capacidad"

[node name="CapacityStatus" type="Label" parent="Margin/VBox/Body/CapacityPanel/CapacityBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3

[node name="CapacityScroll" type="ScrollContainer" parent="Margin/VBox/Body/CapacityPanel/CapacityBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="CapacityGrid" type="GridContainer" parent="Margin/VBox/Body/CapacityPanel/CapacityBox/CapacityScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 0
columns = 7

[node name="Footer" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LevelLabel" type="Label" parent="Margin/VBox/Footer"]
layout_mode = 2
text = "Nivel:"

[node name="LevelSpin" type="SpinBox" parent="Margin/VBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1.0
max_value = 100.0
value = 2.0
rounded = true

[node name="PlayLevelButton" type="Button" parent="Margin/VBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Jugar nivel"

[node name="ExportButton" type="Button" parent="Margin/VBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Exportar CSV"

[node name="BackButton" type="Button" parent="Margin/VBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Volver"

[node name="StatusLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
